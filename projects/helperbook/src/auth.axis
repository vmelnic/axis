      INSERT sessions
        user_id new_user.id

        expires_at NOW_PLUS 30 days
      AS session
      LET welcome_greeting
        T "email.welcome.greeting" name new_user.name
      LET welcome_body
        T "email.welcome.body"
      LET welcome_footer
        T "email.welcome.footer"
      LET welcome_html
        RENDER "email/welcome.html" greeting welcome_greeting body welcome_body footer welcome_footer
      LET send_welcome
        CALL email.send
          to new_user.email
          subject welcome_greeting
          body welcome_html
          html true
        OR 0 "ok"
      INSERT notifications
        user_id new_user.id
        type welcome
        title welcome_greeting
        body welcome_body
      AS welcome_notif
    DEFAULT
      LET new_user
        null
      LET social
        null
      LET welcome_greeting
        null
      LET welcome_body
        null
      LET welcome_footer
        null
      LET welcome_html
        null
      LET send_welcome
        null
      LET welcome_notif
        null
      INSERT sessions
        user_id user.id

        expires_at NOW_PLUS 30 days
      AS session
  RETURN 200 session

-- Social login: LinkedIn (optional)
FLOW linkedin_login post /auth/social/linkedin
  REALM auth_realm
  LIMIT 10 per_minute per_ip
  BODY LinkedInLogin
    code STRING 500 REQUIRED
  LET tokens
    CALL linkedin_auth.exchange_code
      code body.code
    OR 401 "linkedin auth failed"
  LET profile
    CALL linkedin_auth.get_profile
      access_token tokens.access_token
    OR 502 "linkedin profile fetch failed"
  LET user
    FETCH users
      FILTER email EQ profile.email
    OR 0 "ok"
  MATCH
    WHEN EQ user null
      INSERT users
        email profile.email
        email_verified true
        name profile.name
        avatar_url profile.picture
        status active
      AS new_user
      INSERT social_accounts
        user_id new_user.id
        provider linkedin
        provider_user_id profile.sub
        email profile.email
      AS social
      INSERT sessions
        user_id new_user.id

        expires_at NOW_PLUS 30 days
      AS session
    DEFAULT
      LET new_user
        null
      LET social
        null
      INSERT sessions
        user_id user.id

        expires_at NOW_PLUS 30 days
      AS session
  RETURN 200 session

-- Social login: Meta (optional)
FLOW meta_login post /auth/social/meta
  REALM auth_realm
  LIMIT 10 per_minute per_ip
  BODY MetaLogin
    code STRING 500 REQUIRED
  LET tokens
    CALL meta_auth.exchange_code
      code body.code
    OR 401 "meta auth failed"
  LET profile
    CALL meta_auth.get_profile
      access_token tokens.access_token
    OR 502 "meta profile fetch failed"
  LET user
    FETCH users
      FILTER email EQ profile.email
    OR 0 "ok"
  MATCH
    WHEN EQ user null
      INSERT users
        email profile.email
        email_verified true
        name profile.name
        avatar_url profile.picture
        status active
      AS new_user
      INSERT social_accounts
        user_id new_user.id
        provider meta
        provider_user_id profile.id
        email profile.email
      AS social
      INSERT sessions
        user_id new_user.id

        expires_at NOW_PLUS 30 days
      AS session
    DEFAULT
      LET new_user
        null
      LET social
        null
      INSERT sessions
        user_id user.id

        expires_at NOW_PLUS 30 days
      AS session
  RETURN 200 session

-- Webhook: Stripe checkout completed
FLOW stripe_checkout_completed post /webhooks/stripe/checkout
  REALM auth_realm
  AUTH WEBHOOK SIGNATURE stripe_webhook_secret HMAC sha256
  BODY StripeCheckoutEvent
    customer_email STRING 255 REQUIRED
    subscription_id STRING 255 REQUIRED
    amount INT
    currency STRING 10
  LET buyer
    FETCH users
      FILTER email EQ body.customer_email
    OR 200 "acknowledged"
  LET existing_sub
    FETCH subscriptions
      FILTER user_id EQ buyer.id
      FILTER status EQ active
    OR 0 "ok"
  MATCH
    WHEN NEQ existing_sub null
      UPDATE subscriptions
        WHERE id EQ existing_sub.id
        SET plan plus
        SET payment_provider stripe
        SET provider_subscription_id body.subscription_id
        SET expires_at NOW_PLUS 30 days
      AS activated
      OR 404
    DEFAULT
      INSERT subscriptions
        user_id buyer.id
        plan plus
        status active
        payment_provider stripe
        provider_subscription_id body.subscription_id
        expires_at NOW_PLUS 30 days
      AS activated
  LET billing_desc
    T "commerce.subscription.plus_monthly"
  INSERT billing_history
    user_id buyer.id
    amount body.amount
    currency USD
    description billing_desc
    status paid
    payment_provider stripe
    provider_transaction_id body.subscription_id
  AS billing_record
  INSERT notifications
    user_id buyer.id
    type subscription_changed
    title billing_desc
  AS sub_notif
  RETURN 200
    received true

-- Webhook: Stripe subscription cancelled
FLOW stripe_subscription_cancelled post /webhooks/stripe/cancel
  REALM auth_realm
  AUTH WEBHOOK SIGNATURE stripe_webhook_secret HMAC sha256
  BODY StripeCancelEvent
    customer_email STRING 255 REQUIRED
    subscription_id STRING 255 REQUIRED
  LET sub_user
    FETCH users
      FILTER email EQ body.customer_email
    OR 200 "acknowledged"
  LET active_sub
    FETCH subscriptions
      FILTER user_id EQ sub_user.id
      FILTER provider_subscription_id EQ body.subscription_id
    OR 200 "acknowledged"
  UPDATE subscriptions
    WHERE id EQ active_sub.id
    SET status cancelled
    SET cancelled_at NOW
  AS cancelled
  OR 200 "acknowledged"
  LET cancel_title
    T "commerce.subscription.cancelled"
  INSERT notifications
    user_id sub_user.id
    type subscription_changed
    title cancel_title
  AS cancel_notif
  RETURN 200
    received true

-- Webhook: Stripe payment failed
FLOW stripe_payment_failed post /webhooks/stripe/fail
  REALM auth_realm
  AUTH WEBHOOK SIGNATURE stripe_webhook_secret HMAC sha256
  BODY StripeFailEvent
    customer_email STRING 255 REQUIRED
    subscription_id STRING 255
  LET failed_user
    FETCH users
      FILTER email EQ body.customer_email
    OR 200 "acknowledged"
  LET fail_title
    T "commerce.subscription.payment_failed"
  INSERT notifications
    user_id failed_user.id
    type subscription_changed
    title fail_title
  AS fail_notif
  LET fail_push
    CALL push.send_notification
      user_id failed_user.id
      title fail_title
      body fail_title
      data body.subscription_id
    OR 0 "ok"
  RETURN 200
    received true

-- Webhook: generic events
FLOW webhook_receiver post /webhooks/:provider
  REALM auth_realm
  BODY WebhookPayload
    event STRING 100
    data TEXT
  RETURN 200
    received true

FLOW terminate_all_sessions post /auth/sessions/terminate-all
  REALM auth_realm
  AUTH session
  DELETE sessions
    WHERE user_id EQ auth.user_id
  OR 0 "ok"
  RETURN 200
    terminated true
