# Axis runtime
DATABASE_URL=postgres://helperbook:helperbook@localhost:5434/helperbook
JWT_SECRET=helperbook-dev-secret-change-in-production
PORT=3000
DEFAULT_LOCALE=en

# Logging
AXIS_LOG_LEVEL=info
AXIS_LOG_CHANNELS=all

# Directory overrides (optional, defaults to <project>/<name>)
# AXIS_SRC_DIR=./src
# AXIS_ADAPTERS_DIR=./adapters
# AXIS_TEMPLATES_DIR=./templates
# AXIS_LOCALES_DIR=./locales
# AXIS_AUTO_SCHEMA=0

# Docker Compose ports
POSTGRES_PORT=5434
POSTGRES_USER=helperbook
POSTGRES_PASSWORD=helperbook
POSTGRES_DB=helperbook
REDIS_PORT=6380
MEILISEARCH_PORT=7700
MEILI_ENV=development
MAILCATCHER_SMTP_PORT=1025
MAILCATCHER_WEB_PORT=1080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15551234567
SMS_SERVICE_URL=adapter://sms

# Payment (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID_PLUS=your_stripe_price_id_here
PAYMENT_SERVICE_URL=adapter://payment

# Push (Firebase Cloud Messaging)
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVER_KEY=your_server_key_here
FCM_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
PUSH_SERVICE_URL=adapter://push

# Storage (S3-compatible)
S3_BUCKET=helperbook-uploads
S3_REGION=eu-central-1
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here
S3_ENDPOINT=
S3_CDN_URL=https://cdn.helperbook.app
STORAGE_SERVICE_URL=adapter://storage

# AI (OpenAI)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_SERVICE_URL=adapter://openai

# Search (Meilisearch)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_master_key_here
SEARCH_SERVICE_URL=adapter://search

# Geo (Nominatim / OpenStreetMap — free, no API key)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=helperbook/1.0
GEO_SERVICE_URL=adapter://nominatim

# Email: SendGrid (default)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@helperbook.app
SENDGRID_FROM_NAME=Helperbook
EMAIL_SERVICE_URL=adapter://sendgrid

# Email: Mailgun (alternative — change EMAIL_SERVICE_URL to adapter://mailgun)
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.helperbook.app
MAILGUN_FROM_EMAIL=noreply@helperbook.app
MAILGUN_REGION=eu

# Email: SMTP (alternative — change EMAIL_SERVICE_URL to adapter://smtp)
# Production: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_TLS=true
# Development: MailCatcher at localhost:1025 (docker-compose), web UI at localhost:1080
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@helperbook.app
SMTP_FROM_NAME=Helperbook
SMTP_TLS=false

# Calendar (Google)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=https://helperbook.app/auth/google/callback
CALENDAR_SERVICE_URL=adapter://calendar

# Social Login: Google
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_AUTH_SERVICE_URL=adapter://google-oauth

# Social Login: Apple
APPLE_CLIENT_ID=com.helperbook.app
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nXXX\n-----END PRIVATE KEY-----
APPLE_AUTH_SERVICE_URL=adapter://apple-oauth

# Social Login: LinkedIn (optional)
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_REDIRECT_URI=https://helperbook.app/auth/linkedin/callback
LINKEDIN_AUTH_SERVICE_URL=adapter://linkedin-oauth

# Social Login: Meta (optional)
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_REDIRECT_URI=https://helperbook.app/auth/meta/callback
META_AUTH_SERVICE_URL=adapter://meta-oauth
