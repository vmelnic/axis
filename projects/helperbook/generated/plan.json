POST /auth/otp/request request_otp
  COMPUTE sms_result = FuncCall { name: "sms.send_otp", args: [Path { value: "body.phone" }] }
  INSERT otp_codes -> otp_record
  RETURN 200
POST /auth/otp/verify verify_otp
  FETCH otp_codes -> otp (or 401)
  GUARD not_expired 401 "code expired"
  GUARD not_used 401 "code already used"
  UPDATE otp_codes -> used_otp
  FETCH users -> user (or 0)
  MATCH
    WHEN Compare { op: "=", left: Path { value: "user" }, right: Path { value: "null" } }
      INSERT users
      INSERT sessions
      COMPUTE welcome_title
      INSERT notifications
    DEFAULT
      Discriminant(4)
      Discriminant(4)
      Discriminant(4)
      INSERT sessions
  RETURN 200
POST /auth/otp/email/request request_email_otp
  COMPUTE otp_title = FuncCall { name: "T:email.otp.title", args: [] }
  COMPUTE otp_message = FuncCall { name: "T:email.otp.message", args: [] }
  COMPUTE otp_expiry = FuncCall { name: "T:email.otp.expiry_note", args: [Literal { value: "'5'" }] }
  COMPUTE email_otp = FuncCall { name: "email.send_otp", args: [Path { value: "body.email" }, Literal { value: "'email/otp.html'" }, Path { value: "otp_message" }] }
  INSERT otp_codes -> otp_record
  RETURN 200
POST /auth/otp/email/verify verify_email_otp
  FETCH otp_codes -> otp (or 401)
  GUARD not_expired 401 "code expired"
  GUARD not_used 401 "code already used"
  UPDATE otp_codes -> used_otp
  FETCH users -> user (or 0)
  MATCH
    WHEN Compare { op: "=", left: Path { value: "user" }, right: Path { value: "null" } }
      INSERT users
      INSERT sessions
      COMPUTE welcome_greeting
      COMPUTE welcome_body
      COMPUTE welcome_footer
      COMPUTE welcome_html
      COMPUTE send_welcome
      INSERT notifications
    DEFAULT
      Discriminant(4)
      Discriminant(4)
      Discriminant(4)
      Discriminant(4)
      Discriminant(4)
      Discriminant(4)
      Discriminant(4)
      INSERT sessions
  RETURN 200
GET /auth/me get_me
  auth: session
  FETCH users -> user (or 404)
  RETURN 200
PUT /auth/profile update_profile
  auth: session
  UPDATE users -> updated
  RETURN 200
POST /auth/logout logout
  auth: session
  DELETE sessions
  RETURN 204
GET /auth/sessions list_sessions
  auth: session
  QUERY sessions -> active_sessions
  RETURN 200
DELETE /auth/sessions/:id terminate_session
  auth: session
