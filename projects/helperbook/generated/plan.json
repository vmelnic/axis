POST /auth/session/refresh refresh_session
  auth: session
  UPDATE sessions -> refreshed
  RETURN 200
POST /auth/totp/setup totp_setup
  auth: session
  FETCH users -> user (or 404)
  GUARD not_already_enabled 400 "totp already enabled"
  COMPUTE totp_data = FuncCall { name: "totp.generate_secret", args: [Path { value: "auth.user_id" }, Literal { value: "'Helperbook'" }] }
  UPDATE users -> updated
  RETURN 200
POST /auth/totp/enable totp_enable
  auth: session
  FETCH users -> user (or 404)
  GUARD has_secret 400 "call /auth/totp/setup first"
  GUARD not_already_enabled 400 "totp already enabled"
  COMPUTE verify = FuncCall { name: "totp.verify_code", args: [Path { value: "user.totp_secret" }, Path { value: "body.code" }] }
  GUARD valid_code 401 "invalid totp code"
  UPDATE users -> updated
  RETURN 200
POST /auth/totp/disable totp_disable
  auth: session
  FETCH users -> user (or 404)
  GUARD is_enabled 400 "totp is not enabled"
  COMPUTE verify = FuncCall { name: "totp.verify_code", args: [Path { value: "user.totp_secret" }, Path { value: "body.code" }] }
  GUARD valid_code 401 "invalid totp code"
  UPDATE users -> updated
  RETURN 200
