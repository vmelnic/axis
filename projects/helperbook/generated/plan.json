  auth: session
  GUARD not_self 400 "cannot message yourself"
  INSERT conversations -> conversation
  INSERT conversation_participants -> p1
  INSERT conversation_participants -> p2
  RETURN 201
POST /conversations/group create_group
  auth: session
  INSERT conversations -> conversation
  INSERT conversation_participants -> creator_participant
  RETURN 201
PUT /conversations/:id/group update_group
  auth: session
  FETCH conversations -> conversation (or 404)
  GUARD is_group 400 "not a group conversation"
