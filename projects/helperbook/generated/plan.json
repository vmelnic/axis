POST /webhooks/stripe/checkout stripe_checkout_completed
  auth: webhook_signature
  FETCH users -> buyer (or 200)
  FETCH subscriptions -> existing_sub (or 0)
  MATCH
    WHEN Compare { op: "!=", left: Path { value: "existing_sub" }, right: Path { value: "null" } }
      UPDATE subscriptions
    DEFAULT
      INSERT subscriptions
  COMPUTE billing_desc = FuncCall { name: "T:commerce.subscription.plus_monthly", args: [] }
  INSERT billing_history -> billing_record
  INSERT notifications -> sub_notif
  RETURN 200
POST /webhooks/stripe/cancel stripe_subscription_cancelled
  auth: webhook_signature
  FETCH users -> sub_user (or 200)
  FETCH subscriptions -> active_sub (or 200)
  UPDATE subscriptions -> cancelled
  COMPUTE cancel_title = FuncCall { name: "T:commerce.subscription.cancelled", args: [] }
  INSERT notifications -> cancel_notif
  RETURN 200
POST /webhooks/stripe/fail stripe_payment_failed
  auth: webhook_signature
  FETCH users -> failed_user (or 200)
  COMPUTE fail_title = FuncCall { name: "T:commerce.subscription.payment_failed", args: [] }
  INSERT notifications -> fail_notif
  COMPUTE fail_push = FuncCall { name: "push.send_notification", args: [Path { value: "failed_user.id" }, Path { value: "fail_title" }, Path { value: "fail_title" }, Path { value: "body.subscription_id" }] }
  RETURN 200
