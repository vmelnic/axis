  RETURN 200
POST /conversations/:id/members add_group_member
  auth: session
  FETCH conversations -> conversation (or 404)
  GUARD is_group 400 "not a group conversation"
  FETCH conversation_participants -> participant (or 403)
  GUARD is_admin 403 "only admins can add members"
  INSERT conversation_participants -> new_member
  RETURN 201
DELETE /conversations/:conv_id/members/:user_id remove_group_member
  auth: session
  FETCH conversations -> conversation (or 404)
  GUARD is_group 400 "not a group conversation"
  FETCH conversation_participants -> my_role (or 403)
  GUARD is_admin 403 "only admins can remove members"
  DELETE conversation_participants
  RETURN 204
POST /conversations/:id/leave leave_group
  auth: session
  FETCH conversations -> conversation (or 404)
