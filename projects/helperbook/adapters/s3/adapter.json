{
  "name": "s3",
  "version": "0.1.0",
  "description": "File storage via S3-compatible API (AWS S3, MinIO, R2)",
  "service": "storage",
  "methods": ["presign_upload", "presign_download", "delete_object"],
  "provider": "s3",
  "config": {
    "bucket": { "env": "S3_BUCKET", "required": true },
    "region": { "env": "S3_REGION", "required": true },
    "access_key": { "env": "S3_ACCESS_KEY", "required": true, "secret": true },
    "secret_key": { "env": "S3_SECRET_KEY", "required": true, "secret": true },
    "endpoint": { "env": "S3_ENDPOINT", "required": false },
    "cdn_url": { "env": "S3_CDN_URL", "required": false }
  },
  "endpoints": {
    "presign_upload": {
      "method": "POST",
      "url": "local",
      "input": { "key": "string", "content_type": "string", "max_size": "int" },
      "output": { "upload_url": "string", "public_url": "string", "key": "string" }
    },
    "presign_download": {
      "method": "POST",
      "url": "local",
      "input": { "key": "string", "expires_in": "int" },
      "output": { "download_url": "string" }
    },
    "delete_object": {
      "method": "POST",
      "url": "local",
      "input": { "key": "string" },
      "output": { "deleted": "bool" }
    }
  },
  "hot_swap": true
}
